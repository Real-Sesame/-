g"},"390080003":{"id":390080003,"n":"뇌운의 비늘","en":"Thundering Mephis","c":4,"sets":[3],"el":3,"d":"뇌운의 비늘로 변신하여 적을 연속 공격하여 전도 피해를 입히고, 현재 캐릭터의 전도 및 공명 해방 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_222_UI.png"},"6000217":{"id":6000217,"n":"만와뢰 · 잔해","en":"Myriad Snare: Rustfire Chassis","c":4,"sets":[34,35],"el":5,"d":"만와뢰 · 잔해를 소환하여 적에게 용융 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 용융 피해와 강공격 피해가 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34030_UI.png"},"6000221":{"id":6000221,"n":"하늘의 기관 인형 · 겁살","en":"Calamity Effigy","c":4,"sets":[34,35],"el":5,"d":"하늘의 기관 인형 · 겁살로 변신하여 기류 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 기류 피해가 증가된다. 목표에게 「조화 밀집 · 이탈」 추가 시, 자신의 기류 피해가 추가로 증가된다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34032_UI.png"},"6000160":{"id":6000160,"n":"바다의 여인","en":"Lady of the Sea","c":4,"sets":[20],"el":5,"d":"「파도의 소용돌이」를 소환한 후, 적에게 기류 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 기류 피해와 공명 해방 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34018_UI.png"},"6000218":{"id":6000218,"n":"천괴중루","en":"Thousand-Puppet Pavilion","c":4,"sets":[33,38],"el":5,"d":"주변 적에게 인멸 피해를 입히고 「수많은 기억 속 검의 소리」를 소환한다. 자신이 「암흑 효과」 추가 시, 「수많은 기억 속 검의 소리」를 소모하여 목표에게 추가로 인멸 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 인멸 피해와 강공격 피해가 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34031_UI.png"},"390080005":{"id":390080005,"n":"타종 거북이","en":"Bell-Borne Geochelone","c":4,"sets":[8,7],"el":1,"d":"타종 거북이의 실드를 소환한 후 근처 적에게 캐릭터 방어력에 기반한 응결 피해를 입히고, 캐릭터가 받는 피해를 감소시켜, 적에게 입히는 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_992_UI.png"},"6000052":{"id":6000052,"n":"음험한 백로","en":"Impermanence Heron","c":4,"sets":[8],"el":6,"d":"음험한 백로로 변신하여 날아오른 후 내려찍기로 인멸 피해를 입힌다. 에코 어빌리티를 길게 누르면 날아올라 화염을 쏟아부어 인멸 피해를 입힌다. 공격 명중 후 캐릭터 공명 에너지가 회복되고, 다음 변주로 등장하는 캐릭터에게 피해 증가 효과를 부여할 수 있다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_995_UI.png"},"6000199":{"id":6000199,"n":"공명의 메아리 · 명식 · 허무의 신","en":"Reminiscence: Threnodian - Voidborne Construct","c":4,"sets":[30],"el":5,"d":"알레프-원의 창조물을 소환하여 응결 피해를 입힌다. 메인 슬롯에 해당 에코 어빌리티를 장착 시, 자신의 응결과 공명 해방 피해가 증가한다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34027_UI.png"},"6000192":{"id":6000192,"n":"이름없는 탐색자","en":"Nameless Explorer","c":4,"sets":[29,31],"el":5,"d":"이름없는 탐색자를 소환한 후, 적에게 기류 피해를 입힌다. 메인 슬롯에 해당 에코 어빌리티를 장착 시, 자신의 기류 피해와 에코 어빌리티 피해가 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34026_UI.png"},"6000200":{"id":6000200,"n":"공명의 메아리 · 데니아","en":"Reminiscence: Denia","c":4,"sets":[28],"el":5,"d":"「속임수의 대가」를 소환하여 적에게 용융 피해를 입히고 다음번 변주 스킬로 등장하는 캐릭터의 용융 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34028_1_UI.png"},"6000114":{"id":6000114,"n":"영광의 사자","en":"Lioness of Glory","c":4,"sets":[18],"el":5,"d":"에코 어빌리티를 사용하여 「영광의 폴암」을 소환한 후, 주변 적에게 용융 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 용융 피해와 공명 해방 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_33022_UI.png"},"6000201":{"id":6000201,"n":"공명의 메아리 · 악몽 아담 · 스매셔","en":"Reminiscence - Nightmare: Adam Smasher","c":4,"sets":[32],"el":5,"d":"에코 어빌리티 사용 시, 목표에게 물리 피해를 입힌다. 루시 혹은 레베카가 해당 에코 어빌리티 장착 시, 자신의 크리티컬이 증가되고, 에코 어빌리티는 서로 다른 특수 효과를 가진다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34029_1_UI.png"},"6000189":{"id":6000189,"n":"하이와티아","en":"Hyvatia","c":4,"sets":[24,26],"el":5,"d":"하이와티아를 소환하여 적에게 회절 피해를 입히고 다음번 변주 스킬로 등장하는 캐릭터의 전체 속성 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34021_UI.png"},"6000191":{"id":6000191,"n":"시길룸","en":"Sigillum","c":4,"sets":[27],"el":5,"d":"시길룸을 소환한 후, 적에게 용융 피해를 입힌다. 에이메스가 메인 슬롯에 해당 에코 어빌리티를 장착 시, 자신의 공명 해방 피해가 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34025_0_UI.png"},"6000190":{"id":6000190,"n":"리액터 허스크","en":"Reactor Husk","c":4,"sets":[25,28],"el":5,"d":"리액터 허스크로 변신한 후, 적에게 용융 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 공명 효율이 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34022_UI.png"},"6000060":{"id":6000060,"n":"돌아갈 곳이 없는 오류","en":"Fallacy of No Return","c":4,"sets":[7],"el":5,"d":"돌아갈 곳이 없는 오류의 일부 권능을 소환하여 주위의 적을 공격 시, 자신의 공명 효율을 증가시키고 파티 내 모든 캐릭터의 공격력을 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_350_UI.png"},"6000116":{"id":6000116,"n":"공명의 메아리 · 펜리코","en":"Reminiscence: Fenrico","c":4,"sets":[19,21],"el":5,"d":"「계율의 발톱」을 소환하여 주변 목표에게 기류 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 기류 피해와 강공격 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34015_2_UI.png"},"6000167":{"id":6000167,"n":"공명의 메아리 · 명식 · 레비아탄","en":"Reminiscence: Threnodian - Leviathan","c":4,"sets":[22,23],"el":5,"d":"「시야 붕괴」를 소환하여 주변 적에게 인멸 피해를 입히고, 파티 내 캐릭터의 공격에 인멸 피해를 추가한다. 메인 슬롯에 장착 시, 자신의 인멸 피해와 공명 해방 피해가 증가된다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34020_1_UI.png"},"6000121":{"id":6000121,"n":"거짓의 신왕","en":"The False Sovereign","c":4,"sets":[20],"el":5,"d":"거짓의 신왕으로 변신한 후, 주변의 적에게 전도 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 전도 피해와 강공격 피해를 증가시킨다. 변주 스킬을 사용하여 등장 시 거짓의 신왕을 소환하여 적에게 전도 피해를 입힌다","cd":8,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34017_UI.png"},"6000115":{"id":6000115,"n":"악몽 · 헤카테","en":"Nightmare: Hecate","c":4,"sets":[19],"el":5,"d":"악몽 · 헤카테로 변신한 후, 위로 뛰어오른 뒤 내리쳐 3단의 인멸 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 인멸 피해와 에코 어빌리티 피해가 증가된다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34016_UI.png"},"6000106":{"id":6000106,"n":"공명의 메아리 · 플뢰르 드 리스","en":"Reminiscence: Fleurdelys","c":4,"sets":[16,17],"el":3,"d":"「윈드 클리버」를 소환하여, 적에게 기류 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 기류 피해를 증가시키며, 방랑자 · 기류와 카르티시아의 메인 슬롯에 장착 시 기류 피해 보너스가 추가로 증가된다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_34012_1_UI.png"},"6000113":{"id":6000113,"n":"악몽 · 켈피","en":"Nightmare: Kelpie","c":4,"sets":[16,17],"el":5,"d":"악몽 · 켈피로 변신한 후, 주변 적에게 응결 피해를 입힌다. 메인 슬롯에 장착 시 자신의 응결 피해와 기류 피해를 증가시키며, 반주 스킬을 발동하고 퇴장 시 악몽 · 켈피를 소환하여 적에게 기류 피해를 입힌다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_33021_UI.png"},"6000092":{"id":6000092,"n":"악몽 · 애곡하는 아익스","en":"Nightmare: Mourning Aix","c":4,"sets":[11],"el":3,"d":"악몽 · 애곡하는 아익스를 소환하여, 주변 적에게 회절 피해를 입히고, 「광학 효과」의 영향을 받는 적에게 더 많은 피해를 입힌다. 메인 슬롯에 장착 시 자신의 회절 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33020_UI.png"},"6000082":{"id":6000082,"n":"로렐라이","en":"Lorelei","c":4,"sets":[12],"el":3,"d":"로렐라이로 변신한 후, 주변 적에게 인멸 피해를 입힌다. 메인 슬롯에 장착 시 자신의 인멸과 일반 공격 피해를 증가시킨다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_33011_UI.png"},"6000084":{"id":6000084,"n":"탄식의 고룡","en":"Dragon of Dirge","c":4,"sets":[14],"el":3,"d":"탄식의 고룡으로 변신한 후, 「비통의 영역」을 소환하여 일정 범위 내의 적에게 지속적으로 용융 피해를 입힌다. 메인 슬롯에 장착 시 자신의 용융과 일반 공격 피해를 증가시킨다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_33013_UI.png"},"6000087":{"id":6000087,"n":"악몽 · 음험한 백로","en":"Nightmare: Impermanence Heron","c":4,"sets":[12],"el":3,"d":"악몽 · 음험한 백로로 변신한 후, 주변 적에게 다단 인멸 피해를 입힌다. 메인 슬롯에 장착 시 자신의 인멸과 강공격 피해를 증가시킨다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33015_UI.png"},"6000083":{"id":6000083,"n":"이성(異性) 무장","en":"Sentry Construct","c":4,"sets":[10],"el":3,"d":"이성(異性) 무장으로 변신한 후, 전방의 적을 연속으로 공격하여 응결 피해를 입힌다. 장착 캐릭터가 공명 해방을 발동하면 「강습 출력」을 지속적으로 증가시킬 수 있다. 「강습 출력」이 가득 찰 시 이성(異性) 무장으로 변신하면 적을 향해 급강하하여 응결 피해를 입힌다. 메인 슬롯에 장착 시, 자신의 응결과 공명 스킬 피해를 증가시킨다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_33012_UI.png"},"6000053":{"id":6000053,"n":"무망자","en":"Dreamless","c":4,"sets":[6],"el":6,"d":"무망자로 변신하여 계속 적을 공격하여 인멸 피해를 가한다. 공명해방 · 임연사적 발동 후의 방랑자 · 인멸은 해당 에코 어빌리티를 사용하여 적에게 입히는 피해가 증가한다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_998_UI.png"},"6000090":{"id":6000090,"n":"악몽 · 크라운리스","en":"Nightmare: Crownless","c":4,"sets":[6],"el":3,"d":"악몽 · 크라운리스로 변신한 후, 전방의 적에게 인멸 피해를 입힌다. 메인 슬롯에 장착 시 자신의 인멸과 일반 공격 피해를 증가시킨다","cd":12,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33018_UI.png"},"6000059":{"id":6000059,"n":"용의 별자리","en":"Jué","c":4,"sets":[5],"el":5,"d":"짧은 시간 동안 「용의 별자리」를 소환하여 적을 공격하여 회절 피해를 입힌다. 에코 어빌리티 발동 후, 캐릭터의 공명 스킬이 적에게 지속적인 회절 피해를 입힐 수 있다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_323_UI.png"},"6000091":{"id":6000091,"n":"악몽 · 지옥불 기사","en":"Nightmare: Inferno Rider","c":4,"sets":[2],"el":3,"d":"악몽 · 지옥불 기사로 변신한 후, 전방의 적에게 용융 피해를 입힌다. 메인 슬롯에 장착 시 자신의 용융과 공명 스킬 피해를 증가시킨다. 에코 어빌리티를 길게 누르면 변신 상태를 유지하면서 라이딩 상태에 진입할 수 있다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33019_UI.png"},"6000086":{"id":6000086,"n":"악몽 · 폭주의 고릴라","en":"Nightmare: Feilian Beringal","c":4,"sets":[4],"el":3,"d":"악몽 · 폭주의 고릴라를 소환하여 적을 공격하고 기류 피해를 입힌다. 남겨진 「바람의 기둥」도 주변의 적에게 지속적으로 기류 피해를 입힌다. 메인 슬롯에 장착 시 자신의 기류와 강공격 피해를 증가시킨다","cd":20,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33014_UI.png"},"6000088":{"id":6000088,"n":"악몽 · 뇌운의 비늘","en":"Nightmare: Thundering Mephis","c":4,"sets":[3],"el":3,"d":"악몽 · 뇌운의 비늘로 변신한 후, 전방의 적에게 전도 피해를 입힌다. 메인 슬롯에 장착 시 자신의 전도와 공명 해방 피해를 증가시킨다","cd":25,"icon":"UI/UIResources/Common/Image/IconMonsterGoods160/T_IconMonsterGoods160_YZ_33016_UI.png"},"390080007":{"id":390080007,"n":"지옥불 기사","en":"Inferno Rider","c":4,"sets":[2],"el":2,"d":"지옥불 기사로 변신하여 적을 연속 공격하여 용융 피해를 입히고, 자신의 용융과 일반 공격 피해를 증가시킨다. 에코 어빌리티를 길게 누르면 변신 상태를 유지하면서 라이딩 상태에 진입할 수 있다","cd":20,"icon":"UI/UIResources/